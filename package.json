{
  "name": "taskly",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @taskly/app",
    "build": "npm run build -w @taskly/app",
    "start": "npm run start -w @taskly/app",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p test",
    "test": "vitest run --coverage",
    "db:generate": "npm run generate -w @taskly/db",
    "db:migrate": "npm run migrate -w @taskly/db",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --omit=dev --audit-level=high",
    "test:unit": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.mts"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "agent-browser": "^0.39.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "testcontainers": "^12.2.1",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
