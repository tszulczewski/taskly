{
  "version": 1,
  "baseBranch": "main",
  "tracker": "github",
  "browser": { "provider": "agent-browser" },
  "validation": {
    "commands": [
      "npm run format:check",
      "npm run lint",
      "npm run check:agents",
      "npm run test:env-scripts",
      "npm run typecheck",
      "npm test",
      "npm run build",
      "npm run audit",
      "npm run test:integration"
    ]
  },
  "labels": {
    "enabled": true,
    "pipeline": [
      "review",
      "changes-requested",
      "qa",
      "qa-failed",
      "merge-queue",
      "blocked",
      "do-not-merge"
    ],
    "category": ["bug", "feature", "refactor", "security", "dependencies", "documentation"],
    "meta": [
      "needs-qa",
      "skip-qa",
      "qa-approved",
      "qa-self-verified",
      "in-progress",
      "ci-monitoring"
    ],
    "priority": ["priority-low", "priority-medium", "priority-high", "priority-extreme"],
    "risk": ["risk-low", "risk-medium", "risk-high"]
  },
  "qaGate": true,
  "ci": { "maxWaitMinutes": 40 },
  "engine": { "loopStepThreshold": 20, "executorTier": "standard", "stepReview": "final" },
  "paths": {
    "runs": ".ai/runs",
    "analysis": ".ai/analysis",
    "specs": ".ai/specs",
    "dataModel": ".ai/data-model",
    "prototypes": ".ai/prototypes",
    "scripts": ".ai/scripts",
    "qa": ".ai/qa"
  },
  "reviewChecklist": null,
  "closeKeywords": [],
  "agentHarness": {
    "version": 1,
    "preset": "cross-model-jury",
    "host": "claude",
    "delivery": {
      "mode": "stage-only",
      "issueClaim": "hold"
    },
    "retry": {
      "maxAttempts": 4,
      "backoffMs": 5000,
      "backoffMultiplier": 2,
      "timeoutEscalation": 1.5,
      "maxTimeoutMs": 2400000
    },
    "models": {
      "codex": {
        "adapter": "command",
        "family": "openai",
        "model": "gpt-6-luna",
        "reasoningEffort": "xhigh",
        "roles": ["worker", "reviewer"],
        "timeoutMs": 1200000,
        "workerSecurity": {
          "network": "disabled",
          "remoteWrites": "disabled",
          "refWrites": "disabled",
          "enforcedBy": "codex-workspace-write-sandbox"
        },
        "commands": {
          "probe": ["codex", "--version"],
          "review": [
            "codex",
            "exec",
            "--ignore-user-config",
            "--ignore-rules",
            "--ephemeral",
            "--config",
            "model_reasoning_effort={reasoningEffort}",
            "--sandbox",
            "read-only",
            "--cd",
            "{worktree}",
            "--model",
            "{model}",
            "--output-schema",
            "{schemaFile}",
            "-"
          ],
          "worker": [
            "codex",
            "exec",
            "--ignore-user-config",
            "--ignore-rules",
            "--ephemeral",
            "--config",
            "model_reasoning_effort={reasoningEffort}",
            "--sandbox",
            "workspace-write",
            "--cd",
            "{worktree}",
            "--model",
            "{model}",
            "-"
          ]
        }
      }
    },
    "profiles": {
      "standard": {
        "workers": [],
        "reviewers": [],
        "reviewPolicy": {
          "mode": "advisory"
        }
      },
      "optimized": {
        "workers": ["codex"],
        "reviewers": [],
        "reviewPolicy": {
          "mode": "advisory"
        }
      },
      "multi": {
        "workers": [],
        "reviewers": ["codex"],
        "maxParallel": 5,
        "maxInputBytes": 700000,
        "reviewPolicy": {
          "mode": "all-required",
          "requiredReviewers": ["codex"]
        }
      },
      "multi-optimized": {
        "workers": ["codex"],
        "reviewers": ["codex"],
        "maxParallel": 5,
        "maxInputBytes": 700000,
        "reviewPolicy": {
          "mode": "all-required",
          "requiredReviewers": ["codex"]
        }
      }
    }
  }
}
